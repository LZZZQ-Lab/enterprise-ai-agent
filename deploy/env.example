# Task 4.7 production compose — copy to deploy/.env
# cp deploy/env.example deploy/.env

NGINX_HOST_PORT=8080

# vLLM (GPU)
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
VLLM_SERVED_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
VLLM_MAX_LEN=512
VLLM_GPU_UTIL=0.70
VLLM_MAX_NUM_SEQS=16
VLLM_MAX_BATCHED_TOKENS=2048
VLLM_USE_FLASHINFER_SAMPLER=0
HF_ENDPOINT=https://hf-mirror.com

# Platform API / Agent
MODEL_PROVIDER=vllm
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
VLLM_MAX_TOKENS=256
EMBEDDING_PROVIDER=fake
ENABLE_KNOWLEDGE_TOOL=true
DEBUG=false
LOG_LEVEL=INFO

ENABLE_INFRA_METRICS=true
ENABLE_STRUCTURED_LOGGING=true
ENABLE_AGENT_TRACE=false

CHROMA_COLLECTION=enterprise_kb
