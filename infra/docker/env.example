# Copy to docker/.env and adjust (optional; compose defaults work for local GPU dev)
#
# cp docker/env.example docker/.env

# Host ports
BACKEND_HOST_PORT=8001
LLM_HOST_PORT=8000

# vLLM model (HuggingFace id or mounted path inside llm container)
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
VLLM_SERVED_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
VLLM_MAX_LEN=512
VLLM_GPU_UTIL=0.65
VLLM_USE_FLASHINFER_SAMPLER=0

# HuggingFace mirror (optional)
HF_ENDPOINT=https://hf-mirror.com

# Backend LLM routing
MODEL_PROVIDER=vllm
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
VLLM_MAX_TOKENS=256

DEBUG=false
LOG_LEVEL=INFO
