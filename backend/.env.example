####################################
# App
####################################

APP_NAME=Enterprise AI Agent
APP_VERSION=0.1.0
DEBUG=True
HOST=0.0.0.0
PORT=8001
# Swagger 文档页 CDN：unpkg | bootcdn | jsdelivr（/health 正常但 /docs 白屏时用 bootcdn）
# SWAGGER_UI_CDN=bootcdn

####################################
# LLM / Model
####################################

# Provider: openai | local | vllm
# 兼容旧名 LLM_PROVIDER
# MODEL_PROVIDER=openai

# 本地 Qwen 示例（切换为 local 后 Agent 自动走 LocalLLMProvider）:
# MODEL_PROVIDER=local
# MODEL_NAME=Qwen2.5

# vLLM 高性能推理（切换为 vllm 后 Agent 自动走 VLLMProvider）:
# MODEL_PROVIDER=vllm
# VLLM_ENDPOINT=http://localhost:8000/v1
# MODEL_NAME=Qwen2.5

MODEL_PROVIDER=openai

# 兼容旧名 OPENAI_API_KEY
API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
# 模型目录 YAML（可选）；别名与元数据见 app/model_registry/data/models.yaml
# MODEL_REGISTRY_PATH=./config/models.yaml
# 自动路由（Task 7.2）：按 Prompt/Task 选择 Registry 中的模型
# ENABLE_MODEL_ROUTER=true
# MODEL_ROUTER_PREFER_LOW_LATENCY=true
# MODEL_ROUTER_LONG_CONTEXT_CHARS=6000
# 统一推理网关（Task 7.3，默认开启；Agent 经 GatewayLLMProvider）
# ENABLE_INFERENCE_GATEWAY=true
# INFERENCE_BACKEND=vllm
# SGLANG_ENDPOINT=http://localhost:30000/v1
# TGI_ENDPOINT=http://localhost:8080/v1
# 服务发现（Task 7.5）：多 vLLM / SGLang 节点
# ENABLE_SERVICE_DISCOVERY=true
# VLLM_NODES=http://127.0.0.1:8000/v1,http://127.0.0.1:8002/v1
# SGLANG_NODES=http://127.0.0.1:30000/v1
# 模型缓存（Task 7.6）
# ENABLE_MODEL_CACHE=true
# CACHE_BACKEND=memory
# CACHE_BACKEND=redis
# REDIS_URL=redis://127.0.0.1:6379/0
TEMPERATURE=0.7
MAX_TOKENS=4096

# Local Provider（MODEL_PROVIDER=local 时使用）
LOCAL_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
LOCAL_MODEL_DEVICE=auto
LOCAL_MODEL_4BIT=false
LOCAL_MODEL_MAX_NEW_TOKENS=512

# vLLM Provider（MODEL_PROVIDER=vllm 时使用，见 docs/vllm_deployment.md）
# VLLM_ENDPOINT=http://localhost:8000/v1
# VLLM_API_KEY=EMPTY
# VLLM_MAX_TOKENS=256
# VLLM_ENABLE_TOOL_CALLING=false
# 启用 Agent 工具调用时需同时：VLLM_ENABLE_TOOL_CALLING=true，且 vLLM 启动加
# VLLM_ENABLE_TOOL_CALLING=1 bash scripts/start_vllm_server.sh
# MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct

# OpenAI 兼容代理示例（apiqd）:
# OPENAI_BASE_URL=http://apiqd.com/v1
# MODEL_NAME=deepseek-chat

# DeepSeek 官方 API 示例:
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL_NAME=deepseek-chat

####################################
# Embedding (RAG)
####################################

# Provider: openai | local | fake（开发与单测可用 fake）
EMBEDDING_PROVIDER=local
# OpenAI 兼容 Embedding 模型（EMBEDDING_PROVIDER=openai 时）
# EMBEDDING_MODEL=text-embedding-3-small
# 可选固定维度；0 表示使用 Provider 默认
# EMBEDDING_DIMENSION=0
# 本地 sentence-transformers 模型（EMBEDDING_PROVIDER=local 时）
# LOCAL_EMBEDDING_MODEL_ID=BAAI/bge-small-zh-v1.5
# LOCAL_EMBEDDING_DEVICE=cpu

####################################
# Vector Store (RAG)
####################################

# Provider: memory | chroma
VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=enterprise_kb
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.0
ENABLE_KNOWLEDGE_TOOL=true

# MCP（Task 3.7）
ENABLE_MCP=false
MCP_SERVERS=enterprise-demo,local-mock
MCP_SYNC_TO_REGISTRY=true
KNOWLEDGE_UPLOAD_DIR=./data/knowledge_uploads

# Task 4.5：Prometheus /metrics（HTTP + GPU + LLM Token）
ENABLE_INFRA_METRICS=true

# Task 4.6：结构化日志 + Agent Trace 链路
ENABLE_STRUCTURED_LOGGING=true
ENABLE_AGENT_TRACE=false
TRACE_EXPORTER=structured
TRACE_EXPORT_DIR=./artifacts/agent_traces

####################################
# Agent Loop
####################################

MAX_AGENT_LOOP=5

####################################
# LOG_SERVICE_NAME=enterprise-ai-agent
# STRUCTURED_LOG_FILE=./artifacts/logs/structured.ndjson

####################################
# Security (Task 8.6)
####################################

# ENABLE_API_AUTH=false
# API_AUTH_TOKENS=admin-secret:admin:alice,dev-secret:developer:bob
# ENABLE_INPUT_VALIDATION=true
# ENABLE_PROMPT_INJECTION_GUARD=true
# ENABLE_DANGEROUS_TOOL_APPROVAL=true
# MAX_USER_MESSAGE_LENGTH=8000

####################################
# Log
####################################

LOG_LEVEL=INFO
