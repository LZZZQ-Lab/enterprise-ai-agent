  "seed": 42,
  "lora": {
    "r": 8,
    "alpha": 16,
    "dropout": 0.05,
    "load_in_4bit": true,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
